            "{{base_url}}"
          ],
          "path": [
            "api",
            "method",
            "hotel_pms.api.v1.reservation"
          ]
        }
      }
    },
    {
      "name": "Room status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/method/hotel_pms.api.v1.room_status",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "method",
            "hotel_pms.api.v1.room_status"
          ]
        }
      }
